{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Person",
  "description": "A person extracted from unstructured text.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Full name."
    },
    "age": {
      "type": "integer",
      "minimum": 0,
      "maximum": 150,
      "description": "Age in years."
    },
    "city": {
      "type": "string",
      "description": "City of residence, if mentioned."
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Known skills."
    }
  },
  "required": ["name", "age"],
  "additionalProperties": false
}
